# LocalCA deployment environment.
#
# Copy this file to `.env` next to the docker-compose file you use:
#   cp .env.example .env
#
# Django refuses to start when DJANGO_SECRET_KEY is unset, so this file is not
# optional for a container deployment.

# Required. Generate your own; never reuse the value from a repository.
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hostnames/IPs this deployment is served under, comma separated.
# Include every name you will type in the browser, e.g.
#   DJANGO_ALLOWED_HOSTS=localca.lan,192.168.1.10,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origins allowed to submit forms (scheme + host, comma separated).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Leave false. Only enable while debugging; with DEBUG on, any unhandled error
# renders a page containing the secret key, settings and local variables.
DJANGO_DEBUG=false

# Optional: password for the initial superuser on a brand-new database.
# If unset, a random password is generated and printed once in the container log.
# DJANGO_SUPERUSER_PASSWORD=

# Timezone used for displayed timestamps.
TZ=UTC

# Enable these once the app is served over HTTPS (e.g. behind Traefik with TLS):
# DJANGO_SECURE_COOKIES=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000

# Optional, and only read when building from source (docker-compose.yml): the
# uid/gid the application container runs as. The image is unprivileged by
# default (10001), so a database that already belongs to another account -- the
# ./db bind mount owned by you, or a volume written by an older root-running
# image -- cannot be written until these match its owner:
#   APP_UID=$(id -u)
#   APP_GID=$(id -g)
# APP_UID=1000
# APP_GID=1000
