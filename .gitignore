__pycache__/
*.pyc
db.sqlite3
# The sqlite database lives in localca_project/db/ in the docker deployment.
db/
venv/
.venv/
.DS_Store
staticfiles/

# Local, machine-specific scratch space: development secrets (dev.env),
# rendered pages and browser-harness output. Never commit this.
.scratch/
.audit-venv/

# Deployment secrets
.env
ENV

# --- Vue frontend ---
# Dependencies are restored from pnpm-lock.yaml, never committed.
frontend/node_modules/
# Build output. Django serves it, but it is generated by `pnpm build` and by the
# Docker frontend stage, so committing it would only invite stale bundles.
frontend/dist/
# Vite cache and local env overrides.
frontend/.vite/
frontend/.env.local
